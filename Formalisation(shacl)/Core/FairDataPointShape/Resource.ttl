@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix hrishapes: <http://data.health-ri.nl/core/p2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

hrishapes:ResourceShape a sh:NodeShape ;
    rdfs:label "Resource"@en ;
    sh:targetClass dcat:Resource .

hrishapes:aux-ResourceShape a owl:Ontology ;
    rdfs:label "Excel template for Resource class"@en ;
    dct:description "This is an excel template for Resource class in Health RI Core plateau 2."@en ;
    rdfs:comment "Excel template for Resource class"@en ;
    owl:versionInfo "0.1" .

