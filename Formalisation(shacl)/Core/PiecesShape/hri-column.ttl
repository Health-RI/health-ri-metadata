hri:aux-ColumnShape a owl:Ontology;
  rdfs:label "Excel template for Column class"@en;
  rdfs:comment "Excel template for Column class"@en;
  dct:description "This is an excel template for Column class in Health RI Core plateau 2."@en;
  owl:versionInfo "0.1" .

hri:ColumnShape a sh:NodeShape;
  rdfs:label "Column"@en;
  sh:targetClass csvw:Column;
  sh:property <http://data.health-ri.nl/core/p2#ColumnShape/csvw:name>, <http://data.health-ri.nl/core/p2#ColumnShape/csvw:title>,
    <http://data.health-ri.nl/core/p2#ColumnShape/dct:description>, <http://data.health-ri.nl/core/p2#ColumnShape/csvw:datatype>,
    <http://data.health-ri.nl/core/p2#ColumnShape/csvw:propetyUrl> .

<http://data.health-ri.nl/core/p2#ColumnShape/csvw:name> sh:path csvw:name;
  sh:name "name"@en;
  sh:description "A Technical name given to the Variable as it appears in the CSV file."@en;
  sh:minCount 1;
  sh:nodeKind sh:Literal;
  dash:viewer dash:LiteralViewer;
  dash:editor dash:TextFieldEditor .

<http://data.health-ri.nl/core/p2#ColumnShape/csvw:title> sh:path csvw:title;
  sh:name "title"@en;
  sh:description "A Human-readable name given to the Variable."@en;
  sh:minCount 1;
  sh:nodeKind sh:Literal;
  dash:viewer dash:LiteralViewer;
  dash:editor dash:TextFieldEditor .

<http://data.health-ri.nl/core/p2#ColumnShape/dct:description> sh:path dct:description;
  sh:name "description"@en;
  sh:description "Variable description."@en;
  sh:minCount 1;
  sh:nodeKind sh:Literal;
  dash:viewer dash:LiteralViewer;
  dash:editor dash:TextFieldEditor .

<http://data.health-ri.nl/core/p2#ColumnShape/csvw:datatype> sh:path csvw:datatype;
  sh:name "datatype"@en;
  sh:description "Specifies the expected datatype of the values in the column."@en;
  sh:minCount 1;
  sh:maxCount 1;
  sh:nodeKind sh:Literal;
  dash:viewer dash:LiteralViewer;
  dash:editor dash:TextFieldEditor .

<http://data.health-ri.nl/core/p2#ColumnShape/csvw:propetyUrl> sh:path csvw:propetyUrl;
  sh:name "property URL"@en;
  sh:description "A URI template used to define the RDF predicate associated with the values in the column, relative to each row."@en;
  sh:maxCount 1;
  sh:nodeKind sh:IRI;
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .
