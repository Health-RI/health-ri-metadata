<http://data.health-ri.nl/core/p2#DatasetShape/dct:accessRights> sh:path dct:accessRights;
  sh:name "access rights"@en;
  sh:description "Information about who access the resource or an indication of its security status."@en;
  sh:minCount 1;
  sh:maxCount 1;
  sh:nodeKind sh:IRI;
  sh:in _:72d6c52e181b4775bd6458096cf635a92;
  dash:viewer dash:URIViewer;
  dash:editor dash:EnumSelectEditor .

_:72d6c52e181b4775bd6458096cf635a92 rdf:first eu:PUBLIC;
  rdf:rest _:72d6c52e181b4775bd6458096cf635a93 .

_:72d6c52e181b4775bd6458096cf635a93 rdf:first eu:RESTRICTED;
  rdf:rest _:72d6c52e181b4775bd6458096cf635a94 .

_:72d6c52e181b4775bd6458096cf635a94 rdf:first eu:NON_PUBLIC;
  rdf:rest rdf:nil .

