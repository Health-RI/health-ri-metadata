hrishapes:aux-DistributionShape a owl:Ontology;
  rdfs:label "Excel template for Distribution class"@en;
  rdfs:comment "Excel template for Distribution class"@en;
  dct:description "This is an excel template for Distribution class in Health RI Core plateau 2."@en;
  owl:versionInfo "0.1" .

hrishapes:DistributionShape a sh:NodeShape;
  rdfs:label "Distribution"@en;
  sh:targetClass dcat:Distribution;
  sh:property <http://data.health-ri.nl/core/p2/DistributionShape#dcat:accessService>,
    <http://data.health-ri.nl/core/p2/DistributionShape#dcat:accessURL>, <http://data.health-ri.nl/core/p2/DistributionShape#dcatap:applicableLegislation>,
