<http://data.health-ri.nl/core/p2/DatasetShape#hri:healthConditionOfInterest> sh:path
    hri:healthConditionOfInterest;
  sh:name "health condition of interest"@en;
  sh:description "Relates a dataset to a SNOMED CT, ICD-10, ICD-11, or ORPHAcode concept representing a disease, disorder, or other clinical condition that the dataset concerns as a whole."@en;
  sh:nodeKind sh:IRI;
  sh:pattern "^(http://snomed[.]info/id/[0-9]+|http://id[.]who[.]int/icd/entity/[0-9]+|http://id[.]who[.]int/icd/release/10/([0-9]{4}/)?[A-Za-z0-9][A-Za-z0-9.-]* |http://id[.]who[.]int/icd/release/11/.+ |http://www[.]orpha[.]net/ORDO/Orphanet_[0-9]+)$";
  dash:viewer dash:LabelViewer;
  dash:editor dash:URIEditor .

<http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:healthTheme> sh:path healthdcatap:healthTheme;
