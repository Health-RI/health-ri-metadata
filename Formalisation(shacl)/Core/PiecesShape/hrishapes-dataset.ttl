hrishapes:aux-DatasetShape a owl:Ontology;
  rdfs:label "Excel template for Dataset class"@en;
  rdfs:comment "Excel template for Dataset class"@en;
  dct:description "This is an excel template for Dataset class in Health RI Core plateau 2."@en;
  owl:versionInfo "0.1" .

hrishapes:DatasetShape a sh:NodeShape;
  rdfs:label "Dataset"@en;
  sh:targetClass dcat:Dataset;
  sh:property <http://data.health-ri.nl/core/p2/DatasetShape#dct:accessRights>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:alternative>,
    <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:analytics>, <http://data.health-ri.nl/core/p2/DatasetShape#hri:anatomicalLocationCovered>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dcatap:applicableLegislation>, <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:hasCodeValues>,
    <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:hasCodingSystem>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:conformsTo>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dcat:contactPoint>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:creator>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dct:description>, <http://data.health-ri.nl/core/p2/DatasetShape#dcat:distribution>,
    <http://data.health-ri.nl/core/p2/DatasetShape#foaf:page>, <http://data.health-ri.nl/core/p2/DatasetShape#edam:has_topic>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dct:accrualPeriodicity>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:spatial>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dcat:hasVersion>, <http://data.health-ri.nl/core/p2/DatasetShape#hri:healthConditionOfInterest>,
    <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:healthTheme>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:identifier>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dcat:inSeries>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:isReferencedBy>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dcat:keyword>, <http://data.health-ri.nl/core/p2/DatasetShape#dcat:landingPage>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dct:language>, <http://data.health-ri.nl/core/p2/DatasetShape#dpv:hasLegalBasis>,
    <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:maxTypicalAge>, <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:minTypicalAge>,
    <http://data.health-ri.nl/core/p2/DatasetShape#schema:measurementTechnique>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:modified>,
    <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:numberOfRecords>, <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:numberOfUniqueIndividuals>,
    <http://data.health-ri.nl/core/p2/DatasetShape#adms:identifier>, <http://data.health-ri.nl/core/p2/DatasetShape#dpv:hasPersonalData>,
    <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:populationCoverage>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:provenance>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dct:publisher>, <http://data.health-ri.nl/core/p2/DatasetShape#dpv:hasPurpose>,
    <http://data.health-ri.nl/core/p2/DatasetShape#prov:qualifiedAttribution>, <http://data.health-ri.nl/core/p2/DatasetShape#dcat:qualifiedRelation>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dqv:hasQualityAnnotation>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:issued>,
    <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:retentionPeriod>, <http://data.health-ri.nl/core/p2/DatasetShape#adms:sample>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dct:source>, <http://data.health-ri.nl/core/p2/DatasetShape#adms:status>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dct:temporal>, <http://data.health-ri.nl/core/p2/DatasetShape#dcat:temporalResolution>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dcat:theme>, <http://data.health-ri.nl/core/p2/DatasetShape#dct:title>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dct:type>, <http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:hasVariables>,
    <http://data.health-ri.nl/core/p2/DatasetShape#dcat:version>, <http://data.health-ri.nl/core/p2/DatasetShape#adms:versionNotes>,
