<http://data.health-ri.nl/core/p2/DatasetShape#dct:accessRights> sh:path dct:accessRights;
  sh:name "access rights"@en;
  sh:description "Information about who can access the resource or an indication of its security status."@en;
  sh:minCount 1;
  sh:maxCount 1;
  sh:nodeKind sh:IRI;
  sh:in _:4505baf410e048f5893867b62cd667312;
  dash:viewer dash:LabelViewer;
  dash:editor dash:EnumSelectEditor .

_:4505baf410e048f5893867b62cd667312 rdf:first <http://publications.europa.eu/resource/authority/access-right/PUBLIC>;
  rdf:rest _:4505baf410e048f5893867b62cd667313 .

_:4505baf410e048f5893867b62cd667313 rdf:first <http://publications.europa.eu/resource/authority/access-right/RESTRICTED>;
  rdf:rest _:4505baf410e048f5893867b62cd667314 .

_:4505baf410e048f5893867b62cd667314 rdf:first <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC>;
  rdf:rest rdf:nil .

<http://data.health-ri.nl/core/p2/DatasetShape#dct:alternative> sh:path dct:alternative;
  sh:name "alternative"@en;
  sh:description "An alternative name for the dataset."@en;
  sh:nodeKind sh:Literal;
  dash:viewer dash:LiteralViewer;
  dash:editor dash:TextFieldEditor .

<http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:analytics> sh:path healthdcatap:analytics;
  sh:name "analytics"@en;
  sh:description "An analytics distribution of the dataset."@en;
  sh:nodeKind sh:IRI;
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .

<http://data.health-ri.nl/core/p2/DatasetShape#hri:anatomicalLocationCovered> sh:path
    hri:anatomicalLocationCovered;
  sh:name "anatomical location covered"@en;
  sh:description "Relates a dataset to an anatomical class that is Anatomical structure (SNOMED CT 91723000) or one of its subclasses, describing anatomical coverage of the dataset as a whole at metadata or catalogue level."@en;
  sh:nodeKind sh:IRI;
  sh:pattern "^http://snomed\\.info/id/[0-9]{6,18}$";
  dash:viewer dash:LabelViewer;
  dash:editor dash:URIEditor .

<http://data.health-ri.nl/core/p2/DatasetShape#dcatap:applicableLegislation> sh:path
    dcatap:applicableLegislation;
  sh:name "applicable legislation"@en;
  sh:description "The legislation that is applicable to this resource."@en;
  sh:minCount 1;
  sh:nodeKind sh:IRI;
  sh:defaultValue <http://data.europa.eu/eli/reg/2025/327/oj>;
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .

<http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:hasCodeValues> sh:path
    healthdcatap:hasCodeValues;
  sh:name "code values"@en;
  sh:description "Health classifications and their codes associated with the dataset"@en;
  sh:nodeKind sh:IRI;
  dash:viewer dash:LabelViewer;
  dash:editor dash:URIEditor .

<http://data.health-ri.nl/core/p2/DatasetShape#healthdcatap:hasCodingSystem> sh:path
    healthdcatap:hasCodingSystem;
  sh:name "coding system"@en;
  sh:description "Coding systems in use (e.g. ICD-10-CM, DGRs, SNOMED CT, ...)"@en;
  sh:nodeKind sh:IRI;
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .

<http://data.health-ri.nl/core/p2/DatasetShape#dct:conformsTo> sh:path dct:conformsTo;
  sh:name "conforms to"@en;
  sh:description "An established standard to which the described resource conforms."@en;
  sh:nodeKind sh:IRI;
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .

