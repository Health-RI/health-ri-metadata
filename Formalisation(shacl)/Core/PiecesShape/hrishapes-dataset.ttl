  dash:viewer dash:LabelViewer;
  dash:editor dash:URIEditor .

<http://data.health-ri.nl/core/p2/DatasetShape#dcat:hasVersion> sh:path dcat:hasVersion;
  sh:name "has version"@en;
  sh:description "This resource has a more specific, versioned resource."@en;
  sh:nodeKind sh:IRI;
  dash:viewer dash:URIViewer;
