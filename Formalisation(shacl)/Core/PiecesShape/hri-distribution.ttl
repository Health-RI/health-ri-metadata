hri:aux-DistributionShape a owl:Ontology;
  rdfs:label "Excel template for Distribution class"@en;
  rdfs:comment "Excel template for Distribution class"@en;
  dct:description "This is an excel template for Distribution class in Health RI Core plateau 2."@en;
  owl:versionInfo "0.1" .

hri:DistributionShape a sh:NodeShape;
  rdfs:label "Distribution"@en;
  sh:targetClass dcat:Distribution;
  sh:property <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:accessService>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:accessURL>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcatap:applicableLegislation>,
