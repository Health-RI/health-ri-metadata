    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/spdx:checksum>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:compressFormat>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dct:description>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/foaf:page>, <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:downloadURL>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dct:format>, <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dct:language>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dct:license>, <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dct:conformsTo>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:mediaType>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dct:modified>, <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:packageFormat>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dct:issued>, <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/healthdcatap:retentionperiod>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dct:rights>, <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/adms:status>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:temporalResolution>,
    <https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dct:title> .

<https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:accessService>
  sh:path dcat:accessService;
  sh:name "access service"@en;
  sh:description "A data service that gives access to the distribution of the dataset."@en;
  sh:maxCount 1;
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .

<https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:accessURL>
  sh:path dcat:accessURL;
  sh:name "access URL"@en;
  sh:description "A URL of the resource that gives access to a distribution of the dataset. E.g., landing page, feed, SPARQL endpoint."@en;
  sh:minCount 1;
  sh:maxCount 1;
  sh:nodeKind sh:IRI;
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .

<https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcatap:applicableLegislation>
  sh:path dcatap:applicableLegislation;
