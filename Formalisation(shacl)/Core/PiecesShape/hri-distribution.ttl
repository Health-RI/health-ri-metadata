<https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:packageFormat>
  sh:path dcat:packageFormat;
  sh:name "packaging format"@en;
  sh:description "The package format of the distribution in which one or more data files are grouped together, e.g., to enable a set of related files to be downloaded together."@en;
  sh:maxCount 1;
  sh:nodeKind sh:IRI;
