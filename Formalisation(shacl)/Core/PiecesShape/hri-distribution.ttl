<https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/dcat:byteSize> sh:path
    dcat:byteSize;
  sh:name "byte size"@en;
  sh:description "The size of a distribution in bytes."@en;
  sh:maxCount 1;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:nonNegativeInteger;
  dash:viewer dash:LiteralViewer;
  dash:editor dash:TextFieldEditor .

<https://w3id.org/health-ri/metadata-vocabulary#DistributionShape/spdx:checksum> sh:path
    spdx:checksum;
  sh:name "checksum"@en;
  sh:description "The checksum property provides a mechanism that can be used to verify that the contents of a file or package have not changed."@en;
  sh:maxCount 1;
  sh:node hri:ChecksumShape;
  dash:viewer dash:DetailsViewer;
  dash:editor dash:BlankNodeEditor .

