@prefix schema: <http://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dqv: <https://www.w3.org/TR/vocab-dqv/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skosthes: <http://purl.org/iso25964/skos-thes#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix hri: <https://w3id.org/health-ri/metadata-vocabulary#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix edam: <http://edamontology.org/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xls2rdf: <https://xls2rdf.sparna.fr/vocabulary#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .

hri:aux-KindShape a owl:Ontology;
  rdfs:label "Excel template for Kind class"@en;
  rdfs:comment "Excel template for Kind class"@en;
  dct:description "This is an excel template for Kind class in Health RI Core plateau 2."@en;
  owl:versionInfo "0.1" .

hri:KindShape a sh:NodeShape;
  rdfs:label "Kind"@en;
  sh:targetClass vcard:Kind;
  sh:property <https://w3id.org/health-ri/metadata-vocabulary#KindShape/vcard:hasURL>,
    <https://w3id.org/health-ri/metadata-vocabulary#KindShape/vcard:hasEmail>, <https://w3id.org/health-ri/metadata-vocabulary#KindShape/vcard:fn> .

<https://w3id.org/health-ri/metadata-vocabulary#KindShape/vcard:hasURL> sh:path vcard:hasURL;
  sh:name "contact page"@en;
  sh:description "To specify a uniform resource locator associated with the object."@en;
  sh:nodeKind sh:IRI;
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .

<https://w3id.org/health-ri/metadata-vocabulary#KindShape/vcard:hasEmail> sh:path
    vcard:hasEmail;
  sh:name "has email"@en;
  sh:description "To specify the electronic mail address for communication with the object."@en;
  sh:minCount 1;
  sh:maxCount 1;
  sh:nodeKind sh:IRI;
  sh:pattern "^mailto:.+@.+\\..+$";
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .

<https://w3id.org/health-ri/metadata-vocabulary#KindShape/vcard:fn> sh:path vcard:fn;
  sh:name "formatted name"@en;
  sh:description "The formatted text corresponding to the name of the object."@en;
  sh:maxCount 1;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:string;
  dash:viewer dash:LiteralViewer;
  dash:editor dash:TextFieldEditor .
